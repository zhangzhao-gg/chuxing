# MongoDB 连接配置
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=llm_chat

# PostgreSQL connection config
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_NAME=llm_chat

# OpenAI API 配置
OPENAI_API_KEY=sk-your-api-key-here
# 可选：自定义 OpenAI Base URL（用于代理或兼容服务）
# OPENAI_BASE_URL=https://api.openai.com/v1

# LLM 上下文配置
MAX_CONTEXT_TOKENS=4096

# 上下文压缩配置
ENABLE_CONTEXT_COMPRESSION=false
COMPRESSION_THRESHOLD=50
COMPRESSION_TARGET=10

# 服务器配置
API_HOST=0.0.0.0
API_PORT=8000

# Moment 兑现调度（Worker）配置
# 备注：兑现发送由独立 worker 执行，Web 进程只负责写 moments 状态（confirmed/status/remind_time 等）
MOMENT_WORKER_POLL_INTERVAL_SECONDS=2
MOMENT_WORKER_BATCH_SIZE=50
MOMENT_WORKER_LOCK_SECONDS=300
MOMENT_WORKER_MAX_CONCURRENCY=10
MOMENT_WORKER_MAX_ATTEMPTS=8
